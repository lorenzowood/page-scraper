TZ=Europe/London
# Host paths. Point OUTPUT_DIR at the NAS working share (qBittorrent-style inbox).
DATA_DIR=./data
OUTPUT_DIR=./output

# 1 is the small-VM default. Raise only if the host has RAM to spare
# after qBittorrent *and* the 2.5 GiB Chromium cap in docker-compose.yml.
# Beside qBittorrent, 4 GiB RAM for the VM is the practical minimum.
CONCURRENCY=1

# Pause after scroll/cookie dismiss before the still PNG.
SETTLE_S=3

# Optional. If set, send Authorization: Bearer … from the CLI / UI localStorage.
API_TOKEN=

# Optional shell command run on the VM when a job finishes.
# Receives JOB_ID, JOB_STATUS, JOB_OUTPUT_DIR, JOB_FAILED, JOB_TOTAL.
# ON_COMPLETE_HOOK=/output/hooks/on-complete.sh
